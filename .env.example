# Copiar para .env.local (nunca versionado). Só código de servidor lê estas variáveis.

# Anthropic — https://platform.claude.com/settings/keys (definir limite de gasto mensal na consola)
ANTHROPIC_API_KEY=
# Voyage AI — https://dashboard.voyageai.com/ → API Keys
VOYAGE_API_KEY=
# Supabase — Project Settings → API (URL) e API Keys (service_role / secret). NUNCA no browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Sal para o hash do IP (string aleatória longa): python3 -c "import secrets;print(secrets.token_urlsafe(32))"
IP_HASH_SALT=
# Limites de custo
RATE_LIMIT_PER_10MIN=40
DAILY_MESSAGE_CAP=150
# URL público de produção (ex.: https://rag-entreview.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Opcionais (afinação; os valores por omissão estão em lib/config.ts)
# CHAT_MODEL=claude-sonnet-5-5
# GUARD_MODEL=claude-haiku-4-5
# VOYAGE_EMBED_MODEL=voyage-4
# VOYAGE_RERANK_MODEL=rerank-3
# RERANK_MIN_SCORE=0.3

# Observabilidade opcional (Fase 3) — https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
